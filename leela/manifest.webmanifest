{
  "id": "/stats",
  "name": "Lc0 Live",
  "short_name": "Lc0 Live",
  "description": "Your Leela Chess Zero training client: live boards, game analysis, the network, and a stats dashboard.",
  "start_url": "/stats",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1f1d1b",
  "theme_color": "#1f1d1b",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Live boards", "url": "/live", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Analysis", "url": "/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Net explorer", "url": "/net", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
